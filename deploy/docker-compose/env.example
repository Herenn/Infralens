# InfraLens Configuration
# =======================
# Copy this file to .env and configure as needed

# Node name for the agent
HOSTNAME=my-server

# ===========================
# Security (Optional)
# ===========================
# API key shared by backend and agents. Empty = auth disabled.
# Generate one with: openssl rand -hex 32
API_KEY=

# ===========================
# AI Documentation (Optional)
# ===========================
# Configure at least one provider for AI features

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-pro

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Default provider (openai, anthropic, gemini, ollama)
DEFAULT_LLM_PROVIDER=openai
