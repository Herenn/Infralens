# InfraLens Configuration
# =======================
# Copy this file to .env and configure as needed

# Node name for the agent
HOSTNAME=my-server

# ===========================
# Security (Optional)
# ===========================
# API key shared by backend and agents. Empty = auth disabled.
# Generate one with: openssl rand -hex 32
API_KEY=

# UI login. Empty = no login screen; the UI and all read endpoints (topology,
# history, WebSocket) are public, as in v3.0. When set, they require signing
# in (or the API key). Use a long random password: openssl rand -base64 24
UI_PASSWORD=
# UI_USERNAME=admin
# Signs session cookies so sessions survive backend restarts (and work across
# replicas). At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# SESSION_TTL=12h
# Login throttling is per client. Behind the bundled nginx the client is read
# from X-Forwarded-For, trusted from loopback/private addresses (one hop). If
# untrusted clients on your LAN can reach port 8080 directly, list only the
# real proxy addresses instead, e.g. TRUSTED_PROXIES=172.18.0.0/16
# TRUSTED_PROXIES=

# ===========================
# Architecture drift notifications (Optional)
# ===========================
# POSTed to when a never-before-seen dependency appears or an established one
# stops being observed. A Slack/Mattermost incoming webhook URL works as-is.
# Changes are always shown in the UI's Changes feed; DRIFT_ENABLED=false turns
# drift detection (feed and webhook) off.
# DRIFT_ENABLED=true
DRIFT_WEBHOOK_URL=
# DRIFT_GONE_AFTER=24h

# ===========================
# Idle spend (Optional)
# ===========================
# Approximate monthly cost of services nothing talks to. No prices are built
# in: leave these empty to see idle services and their evidence without costs.
# Monthly cost of one node (in IDLE_COST_CURRENCY; a label, no conversion)
IDLE_COST_NODE_MONTHLY=
# Per-node overrides and per-service prices, glob=price, ";"-separated
# IDLE_COST_NODE_PRICES=gpu-*=1800;db-1=420
# IDLE_COST_SERVICE_PRICES=billing-db=310
# IDLE_COST_CURRENCY=USD
# Never flag these (known cron jobs, DR standbys)
# IDLE_COST_EXCLUDE=nightly-*;dr-standby
# IDLE_COST_QUIET_AFTER=72h

# ===========================
# MCP server for AI assistants (Optional)
# ===========================
# Serves read-only topology tools at http://<backend>:8080/mcp for Claude Code,
# Claude Desktop, Cursor and other MCP clients.
# MCP_ENABLED=true
# Read-only key accepted on /mcp only - put this in AI client configs instead
# of API_KEY (which can also ingest events and spend LLM credit). When any key
# (API_KEY or MCP_API_KEY) is set, /mcp requires one; with neither, /mcp is
# open only if ALLOW_NO_AUTH=true. Generate one with: openssl rand -hex 32
MCP_API_KEY=
# Extra browser origins allowed to call /mcp (comma-separated); non-browser
# clients and loopback origins are always allowed.
# MCP_ALLOWED_ORIGINS=

# ===========================
# AI Documentation (Optional)
# ===========================
# Configure at least one provider for AI features

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-pro

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Default provider (openai, anthropic, gemini, ollama)
DEFAULT_LLM_PROVIDER=openai
