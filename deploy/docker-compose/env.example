# InfraLens Configuration
# =======================
# Copy this file to .env and configure as needed

# Node name for the agent
HOSTNAME=my-server
# EXPERIMENTAL: label external destinations with the DNS names workloads
# resolved (agent captures DNS answers; needs CAP_NET_RAW, which the
# privileged agent has). Off by default; not yet run on a real cluster by the
# maintainers - see "DNS Names" in the README for the trust model and the
# smoke test to run first. Names are display labels, not verified facts.
# INFRALENS_DNS_NAMES=false

# ===========================
# Security (Optional)
# ===========================
# API key shared by backend and agents. Required unless ALLOW_NO_AUTH=true.
# Generate one with: openssl rand -hex 32
API_KEY=
# Start without an API key (evaluation / trusted networks only).
# ALLOW_NO_AUTH=false

# UI login. Empty = no login screen; the UI and all read endpoints (topology,
# history, WebSocket) are public, as in v3.0. When set, they require signing
# in (or the API key). Use a long random password: openssl rand -base64 24
UI_PASSWORD=
# UI_USERNAME=admin
# Signs session cookies so sessions survive backend restarts (and work across
# replicas). At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# SESSION_TTL=12h
# Login throttling is per client. Behind the bundled nginx the client is read
# from X-Forwarded-For, trusted from loopback/private addresses (one hop). If
# untrusted clients on your LAN can reach port 8080 directly, list only the
# real proxy addresses instead, e.g. TRUSTED_PROXIES=172.18.0.0/16
# TRUSTED_PROXIES=

# ===========================
# Topology history
# ===========================
# On by default. History lives in the infralens-data volume and, unlike
# current state, cannot be re-derived - back the volume up before upgrading
# (an older InfraLens will not start on a database a newer one migrated).
# HISTORY_ENABLED=true
# HISTORY_RETENTION=720h
# HISTORY_MAX_GAP=5m

# ===========================
# Architecture drift notifications (Optional)
# ===========================
# POSTed to when a never-before-seen dependency appears or an established one
# stops being observed. A Slack/Mattermost incoming webhook URL works as-is.
# Changes are always shown in the UI's Changes feed; DRIFT_ENABLED=false turns
# drift detection (feed and webhook) off.
# DRIFT_ENABLED=true
DRIFT_WEBHOOK_URL=
# Timings apply to the feed with or without a webhook.
# DRIFT_CHECK_INTERVAL=5m
# DRIFT_GONE_AFTER=24h
# DRIFT_WARMUP=1h

# ===========================
# Idle spend (Optional)
# ===========================
# Approximate monthly cost of services nothing talks to. No prices are built
# in: leave these empty to see idle services and their evidence without costs.
# Monthly cost of one node (in IDLE_COST_CURRENCY; a label, no conversion)
IDLE_COST_NODE_MONTHLY=
# Per-node overrides and per-service prices, glob=price, ";"-separated
# IDLE_COST_NODE_PRICES=gpu-*=1800;db-1=420
# IDLE_COST_SERVICE_PRICES=billing-db=310
# IDLE_COST_CURRENCY=USD
# Never flag these (known cron jobs, DR standbys)
# IDLE_COST_EXCLUDE=nightly-*;dr-standby
# History consulted, observed silence before flagging, and minimum age.
# Durations accept a day suffix (30d); a malformed value is ignored with a
# warning shown in the Idle spend panel.
# IDLE_COST_WINDOW=720h
# IDLE_COST_QUIET_AFTER=72h
# IDLE_COST_WARMUP=24h

# ===========================
# MCP server for AI assistants (Optional)
# ===========================
# Serves read-only topology tools at http://<backend>:8080/mcp for Claude Code,
# Claude Desktop, Cursor and other MCP clients.
# MCP_ENABLED=true
# Read-only key accepted on /mcp only - put this in AI client configs instead
# of API_KEY (which can also ingest events and spend LLM credit). When any key
# (API_KEY or MCP_API_KEY) is set, /mcp requires one. With neither: if
# UI_PASSWORD is set /mcp refuses every request; otherwise it is open only if
# ALLOW_NO_AUTH=true. Generate one with: openssl rand -hex 32
MCP_API_KEY=
# Extra browser origins allowed to call /mcp (comma-separated); non-browser
# clients and loopback origins are always allowed.
# MCP_ALLOWED_ORIGINS=

# ===========================
# AI Documentation (Optional)
# ===========================
# Configure at least one provider for AI features

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
# Leave a *_MODEL empty to use the backend default (gpt-6-luna)
OPENAI_MODEL=

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Empty = backend default (claude-haiku-5-5)
ANTHROPIC_MODEL=

# Google Gemini
GEMINI_API_KEY=your-gemini-key
# Empty = backend default (gemini-3.5-flash-lite)
GEMINI_MODEL=

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
# Empty = first locally installed model
OLLAMA_MODEL=

# Default provider (openai, anthropic, gemini, ollama)
DEFAULT_LLM_PROVIDER=openai
