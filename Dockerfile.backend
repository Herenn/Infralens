# InfraLens Backend Dockerfile
# ============================
# Multi-stage build for minimal image size

# Build stage
FROM golang:1.22-bookworm AS builder

WORKDIR /app

# Copy go mod files from root (monorepo structure)
COPY go.mod go.sum ./
RUN go mod download

# Copy backend source
COPY backend/ ./backend/

# Build
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /infralens-backend ./backend

# Runtime stage
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /infralens-backend /infralens-backend

EXPOSE 8080

ENTRYPOINT ["/infralens-backend"]
CMD ["--debug"]
